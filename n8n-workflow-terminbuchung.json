      "id": "wki-extract-0002",
      "name": "KI-Mail extrahieren",
      "parameters": {
        "jsCode": "const req = $('Validieren & Slot').first().json;\nconst content = $json.message?.content || $json.content || '';\nlet aiEmail = content.trim();\nlet aiError = '';\nif (!aiEmail) aiError = 'Ollama lieferte keinen Content';\n\nif (!aiEmail) {\n  aiEmail = `<p>Hallo ${req.name},</p><p>vielen Dank für Ihre Anfrage. Ihr Wunschtermin ist eingetragen:</p><p><strong>${new Date(req.startIso).toLocaleString('de-DE', {timeZone:'Europe/Berlin'})} Uhr</strong> (30 Minuten, online).</p><p>Die Einwahldaten erhalten Sie mit der endgültigen Bestätigung.</p><p>Mit freundlichen Grüßen<br>Xavier Escalante · Skalantech</p>`;\n}\n\nreturn [{ ...req, aiEmail, aiError }];"
      },
