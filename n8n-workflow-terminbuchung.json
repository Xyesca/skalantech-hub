    {
      "id": "wki-8d636ebe",
      "name": "Validieren & Slot",
      "parameters": {
        "jsCode": "let b = $json;\nif (b && typeof b.body === 'object' && b.body !== null && !Array.isArray(b.body)) {\n  b = b.body;\n} else if (b && typeof b.body === 'string' && b.body.trim().startsWith('{')) {\n  try { b = JSON.parse(b.body); } catch (e) {}\n}\nconst name = (b.name || '').toString().trim();\nconst email = (b.email || '').toString().trim();\nconst company = (b.company || '').toString().trim();\nconst topic = (b.topic || 'Erstgespräch').toString().trim();\nconst message = (b.message || '').toString().trim();\nconst day = (b.preferred_day || '').toString().trim();\nconst time = (b.preferred_time || '').toString().trim();\n\nconst out = { name, email, company, topic, message, day, time, valid: false };\nif (!name || !email || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) {\n  out.error = 'Name und gültige E-Mail sind erforderlich.';\n  return [out];\n}\nif (!day || !time) {\n  out.valid = true; out.hasSlot = false;\n  return [out];\n}\nconst [yy, mm, dd] = day.split('-').map(Number);\nconst [hh, mi] = time.split(':').map(Number);\nif (!yy || !mm || !dd || isNaN(hh) || isNaN(mi)) {\n  out.valid = true; out.hasSlot = false;\n  return [out];\n}\nconst start = new Date(Date.UTC(yy, mm - 1, dd, hh, mi));\nconst end = new Date(start.getTime() + 30 * 60000);\nout.valid = true; out.hasSlot = true;\nout.startIso = start.toISOString();\nout.endIso = end.toISOString();\nout.dayStartIso = new Date(Date.UTC(yy, mm - 1, dd, 0, 0)).toISOString();\nout.dayEndIso = new Date(Date.UTC(yy, mm - 1, dd, 23, 59)).toISOString();\nreturn [out];"
      },
