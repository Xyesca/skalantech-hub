# Skalantech Hub — Umgebungsvariablen
ADMIN_USERNAME=admin
ADMIN_PASSWORD=***
SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=true
DATABASE_URL=

# Interner n8n-Webhook für die Terminbuchung
# Bei gemeinsamer Host-Netzwerk-Nutzung auf dem VPS:
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/skalantech-termin

# Optional: Gmail SMTP für Kontaktformular-Benachrichtigungen
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=***
