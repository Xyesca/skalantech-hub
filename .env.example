# Skalantech Hub — Umgebungsvariablen
ADMIN_USERNAME=admin
ADMIN_PASSWORD=***
SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=true
DATABASE_URL=

# Interne n8n-Webhooks auf demselben VPS
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/skalantech-termin
N8N_LEAD_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lead-erfassung
N8N_DEMO_BASE_URL=http://127.0.0.1:5678/webhook

# Öffentliche Skalantech-Absenderadresse
BUSINESS_EMAIL=xyesca@skalantech.store

# IONOS Mail — Credentials gehören in n8n Credentials / lokale .env, niemals ins Git-Repository.
IONOS_SMTP_HOST=smtp.ionos.de
IONOS_SMTP_PORT=465
IONOS_IMAP_HOST=imap.ionos.de
IONOS_IMAP_PORT=993
IONOS_MAIL_USER=xyesca@skalantech.store
IONOS_MAIL_PASSWORD=***

# CRM-API-Schlüssel (X-API-Key) für Automation (n8n/Hermes) — /api/crm/*
CRM_API_KEY=replace-with-a-long-random-value

# Zentraler Rate-Limit-Storage (Issue #4) — Production-Default ist
# redis://127.0.0.1:6379/0 (Container skalantech-redis, nur loopback).
# Nur für lokale Entwicklung/Tests auf memory:// setzen.
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
